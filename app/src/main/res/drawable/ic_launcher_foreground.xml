<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Scaled to 82% around the centre: the design reaches about 40dp from the centre (the cream circle), past the
        33dp safe zone that every launcher mask keeps. Unscaled, Samsung's mask cut into the circle.
        Moved 1.8 right: the design's bounding box is centred 2.2 left of the canvas centre (1.8 after scaling),
        so it looked off to the left.
        The circle is 1.7 higher than the original, for more space above the blue stroke: as far up as the safe
        zone allows (its top-left edge now reaches 33dp from the centre).
        The folded corner is 1.5x the original, scaled away from the stroke's unfolded corner (82.69, 43.45), so
        it keeps its shape after the scaling down.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="1.8">

        <!-- Cream Circle Accent -->
        <path
            android:fillColor="#EFE8D8"
            android:pathData="M 24.47,29.1 a 9.7,9.7 0 1,0 19.4,0 a 9.7,9.7 0 1,0 -19.4,0" />

        <!-- Blue Left Stroke of 'V' -->
        <path
            android:fillColor="#2568BA"
            android:pathData="M25.31,43.45 L43.03,43.45 L62.86,86.48 L45.14,86.48 Z" />

        <!-- Red Right Stroke of 'V' -->
        <path
            android:fillColor="#C83823"
            android:pathData="M64.97,43.45 L70.03,43.45 L77.39,54.94 L62.86,86.48 L45.14,86.48 Z" />

        <!-- Fold Shadow -->
        <path
            android:fillColor="#9D2918"
            android:pathData="M70.03,43.45 L77.39,54.94 L66.86,58.01 Z" />

        <!-- Cream Folded Page Corner -->
        <path
            android:fillColor="#EFE8D8"
            android:pathData="M70.03,43.45 L77.39,54.94 L67.94,54.97 Z" />
    </group>
</vector>
