<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS only, to Google's Drive API: no cleartext, and only the system's certificate authorities (no user-added
    ones, which could read Drive traffic).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
