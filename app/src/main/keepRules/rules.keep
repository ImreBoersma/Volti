# Project R8 rules. AGP combines every file in src/main/keepRules and passes it to R8.
# See https://d.android.com/r/tools/r8/keep-rules

# Keep names readable: a stack trace from the stand must be readable without the mapping file of
# that exact build. Shrinking and optimisation stay on; renaming gains little in a 2 MB app.
-dontobfuscate

# Release builds don't log routine events: no file URIs or page turns in logcat.
# Log.w and Log.e stay, for diagnosing a problem after a rehearsal.
-assumenosideeffects class android.util.Log {
    public static int d(...);
    public static int i(...);
    public static int v(...);
}
