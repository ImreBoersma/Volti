<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for Google's Drive API (milestone 3): HTTPS, and only while the library is open. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Volti">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Volti"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                A PDF from another app (Gmail, WhatsApp, Files): Open with and Share. It is imported into an
                ensemble I pick, under the same limits as a download. No permission needed: the other app grants
                read access to just that file. singleTask: one Volti, in its own task, also when shared from inside
                another app; a share while Volti is open arrives through onNewIntent.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            PDFium parses untrusted files. It runs here, in its own process with no permissions and no access
            to the folder grant: it only gets the file descriptor the app hands it. A crash or hang kills this
            process, not the app.
        -->
        <service
            android:name=".render.PdfRenderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":pdf" />
    </application>

</manifest>
